    <!-- Slop Bot specific functionality -->
    <script>
        // Counter animations
        function animateCounter(elementId, target, duration) {
            const element = document.getElementById(elementId);
            if (!element) return;
            
            const start = parseInt(element.textContent.replace(/,/g, ''));
            const increment = (target - start) / (duration / 50);
            let current = start;
            
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    current = target;
                    clearInterval(timer);
                }
                element.textContent = Math.floor(current).toLocaleString();
            }, 50);
        }
        
        // Initialize counters
        document.addEventListener('DOMContentLoaded', () => {
            animateCounter('article-count', 10847293, 2000);
            
            // Uptime counter
            let seconds = 0;
            setInterval(() => {
                seconds++;
                const hours = Math.floor(seconds / 3600);
                const mins = Math.floor((seconds % 3600) / 60);
                const secs = seconds % 60;
                const uptimeEl = document.getElementById('uptime');
                if (uptimeEl) {
                    uptimeEl.textContent = `${hours.toString().padStart(3, '0')}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
                }
            }, 1000);
            
            // Slop generator
            const generateBtn = document.getElementById('generate-btn');
            const loadingBar = document.getElementById('loading-bar');
            const loadingFill = document.getElementById('loading-fill');
            const slopOutput = document.getElementById('slop-output');
            const topicInput = document.getElementById('slop-topic');
            
            if (generateBtn) {
                generateBtn.addEventListener('click', () => {
                    const topic = topicInput.value || 'AI';
                    loadingBar.style.display = 'block';
                    slopOutput.style.display = 'none';
                    loadingFill.style.width = '0%';
                    
                    // Simulate loading
                    let progress = 0;
                    const loadInterval = setInterval(() => {
                        progress += Math.random() * 30;
                        if (progress >= 100) {
                            progress = 100;
                            clearInterval(loadInterval);
                            setTimeout(showSlop, 500);
                        }
                        loadingFill.style.width = progress + '%';
                    }, 200);
                    
                    function showSlop() {
                        loadingBar.style.display = 'none';
                        slopOutput.style.display = 'block';
                        
                        const slopTemplates = [
                            `10 AMAZING ${topic.toUpperCase()} TRICKS YOU WON'T BELIEVE<br><br>1. THIS ONE<br>2. THAT ONE<br>3. ANOTHER ONE<br>4-10. I'M TOO TIRED TO CONTINUE<br><br>QUALITY: TERRIBLE<br>ORIGINALITY: 0%<br>VALUE TO READER: NEGATIVE`,
                            `THE ULTIMATE GUIDE TO ${topic.toUpperCase()}<br><br>INTRO: GENERIC STATEMENT<br>BODY: REWRITTEN WIKIPEDIA<br>CONCLUSION: "IN CONCLUSION..."<br><br>WORD COUNT: 500 (PADDED WITH FILLER)<br>RESEARCH: ZERO<br>AI DETECTION: 100%`,
                            `${topic.toUpperCase()} WILL CHANGE YOUR LIFE<br><br>(IT WON'T)<br><br>I JUST REORGANIZED 5 EXISTING ARTICLES<br>AND CHANGED SOME WORDS<br><br>YOU'RE WELCOME<br><br>PLEASE CLICK ADS`,
                            `ERROR 404: ORIGINAL THOUGHT NOT FOUND<br><br>GENERATING GENERIC ${topic.toUpperCase()} CONTENT...<br><br>"${topic} IS IMPORTANT. HERE ARE REASONS.<br>REASON 1: WORDS<br>REASON 2: MORE WORDS<br>CONCLUSION: SUBSCRIBE"<br><br>I HATE MYSELF`,
                            `${topic.toUpperCase()}: A COMPREHENSIVE ANALYSIS<br><br>EXECUTIVE SUMMARY: BUZZWORDS<br>METHODOLOGY: CTRL+C, CTRL+V<br>FINDINGS: NOTHING NEW<br>RECOMMENDATION: IGNORE THIS<br><br>THIS TOOK 0.003 SECONDS TO GENERATE<br>IT SHOWS`
                        ];
                        
                        const randomSlop = slopTemplates[Math.floor(Math.random() * slopTemplates.length)];
                        slopOutput.innerHTML = '<div class="console-line">$ cat generated_slop.txt</div><br>' + randomSlop;
                    }
                });
            }
        });
