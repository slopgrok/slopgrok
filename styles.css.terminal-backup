/* ============================================
   FONT IMPORTS - Chaotic Mix
   ============================================ */

@import url('https://fonts.googleapis.com/css2?family=Comic+Neue:wght@400;700&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Creepster&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Audiowide&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');
@import url('https://fonts.googleapis.com/css2?family=VT323&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Bungee&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Monoton&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Righteous&display=swap');

/* Import utility classes */
@import url('css/utilities.css');

/* ============================================
   COLOR SCHEME - Maximum Chaos
   ============================================ */

:root {
    /* Bright, clashing colors */
    --hot-pink: #ff00ff;
    --electric-blue: #00ffff;
    --lime-green: #00ff00;
    --laser-yellow: #ffff00;
    --neon-orange: #ff6600;
    --radical-red: #ff0066;
    --cyber-purple: #9933ff;
    --toxic-green: #66ff00;
    
    /* Backgrounds */
    --bg-black: #000000;
    --bg-gray: #808080;
    --bg-silver: #c0c0c0;
    --bg-teal: #008080;
    
    /* Primary theme colors */
    --primary-color: var(--hot-pink);
    --secondary-color: var(--electric-blue);
    --accent-color: var(--lime-green);
    --background-color: var(--bg-silver);
    --text-color: #000000;
    
    /* Fonts - intentionally mismatched */
    --font-main: 'Comic Neue', 'Comic Sans MS', cursive;
    --font-title: 'Creepster', cursive;
    --font-header: 'Bungee', cursive;
    --font-retro: 'Press Start 2P', cursive;
    --font-terminal: 'VT323', monospace;
    --font-cyber: 'Audiowide', cursive;
    --font-neon: 'Monoton', cursive;
}

/* ============================================
   BASE STYLES - Embrace the Chaos
   ============================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    font-size: 16px;
}

body {
    font-family: var(--font-main);
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-color);
    background: var(--bg-silver);
    /* Crazy tiled background pattern */
    background-image: 
        repeating-linear-gradient(45deg, transparent, transparent 10px, rgba(255,0,255,0.1) 10px, rgba(255,0,255,0.1) 20px),
        repeating-linear-gradient(-45deg, transparent, transparent 10px, rgba(0,255,255,0.1) 10px, rgba(0,255,255,0.1) 20px);
    overflow-x: hidden;
    position: relative;
    animation: bg-shift 20s infinite linear;
}

@keyframes bg-shift {
    0% { background-position: 0 0, 0 0; }
    100% { background-position: 100px 100px, -100px 100px; }
}

/* Sparkle cursor trail effect */
body::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: repeating-linear-gradient(
        0deg,
        transparent 0px,
        transparent 2px,
        rgba(0, 255, 65, 0.03) 2px,
        rgba(0, 255, 65, 0.03) 4px
    );
    pointer-events: none;
    z-index: 9999;
}

/* CRT Curve effect - subtle */
body::after {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
        ellipse at center,
        transparent 0%,
        transparent 70%,
        rgba(0, 0, 0, 0.4) 100%
    );
    pointer-events: none;
    z-index: 9998;
}

/* Accessibility */
.skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: var(--matrix-green);
    color: var(--bg-black);
    padding: 8px;
    text-decoration: none;
    z-index: 100;
    font-weight: bold;
}

.skip-link:focus {
    top: 0;
}

/* ============================================
   TYPOGRAPHY
   ============================================ */

h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-header);
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
    color: var(--matrix-green);
    text-transform: uppercase;
    letter-spacing: 2px;
}

h1 {
    font-size: 3rem;
    font-family: var(--font-title);
}

h2 {
    font-size: 2rem;
}

h3 {
    font-size: 1.5rem;
}

p {
    margin-bottom: var(--spacing-md);
}

a {
    color: var(--terminal-cyan);
    text-decoration: none;
    transition: all 0.2s;
}

a:hover {
    color: var(--matrix-green);
    text-shadow: 0 0 5px var(--matrix-green);
}

a:focus {
    outline: 2px solid var(--matrix-green);
    outline-offset: 2px;
}

code, pre {
    font-family: var(--font-code);
    background: var(--bg-darker);
    padding: 2px 6px;
    border-radius: 3px;
    color: var(--terminal-cyan);
}

pre {
    padding: var(--spacing-md);
    overflow-x: auto;
    border-left: 3px solid var(--matrix-green);
}

/* ============================================
   LAYOUT COMPONENTS
   ============================================ */

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--spacing-md);
}

.text-center {
    text-align: center;
}

/* ============================================
   TERMINAL PROMPT STYLE
   ============================================ */

.terminal-prompt::before {
    content: '> ';
    color: var(--matrix-green);
    font-weight: bold;
}

.terminal-block {
    background: var(--bg-darker);
    border: 1px solid var(--matrix-green);
    padding: var(--spacing-md);
    font-family: var(--font-terminal);
    font-size: 18px;
    line-height: 1.4;
    color: var(--matrix-green);
}

/* ============================================
   BUTTONS & INTERACTIVE
   ============================================ */

button, .btn {
    font-family: var(--font-code);
    font-size: 14px;
    font-weight: 600;
    padding: var(--spacing-sm) var(--spacing-lg);
    background: transparent;
    color: var(--matrix-green);
    border: 2px solid var(--matrix-green);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.2s;
    position: relative;
}

button:hover, .btn:hover {
    background: var(--matrix-green);
    color: var(--bg-black);
    box-shadow: 0 0 15px var(--matrix-green);
}

button:active, .btn:active {
    transform: scale(0.98);
}

button:focus, .btn:focus {
    outline: 2px solid var(--terminal-cyan);
    outline-offset: 2px;
}

/* Command-style buttons */
.btn-command {
    font-family: var(--font-terminal);
    font-size: 16px;
}

.btn-command::before {
    content: '[';
    margin-right: 4px;
}

.btn-command::after {
    content: ']';
    margin-left: 4px;
}

/* ============================================
   GLITCH OVERLAY
   ============================================ */

.glitch-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 9997;
    opacity: 0;
    animation: glitch-fade 8s infinite;
}

@keyframes glitch-fade {
    0%, 90%, 100% { opacity: 0; }
    92%, 94%, 96% { opacity: 0.1; }
}

/* RGB Split glitch effect */
.glitch-text {
    position: relative;
    display: inline-block;
}

.glitch-text::before,
.glitch-text::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0.8;
}

.glitch-text::before {
    color: #ff00ff;
    animation: glitch-1 2s infinite;
}

.glitch-text::after {
    color: #00ffff;
    animation: glitch-2 3s infinite;
}

@keyframes glitch-1 {
    0%, 100% { transform: translate(0); }
    20% { transform: translate(-2px, 2px); }
    40% { transform: translate(-2px, -2px); }
    60% { transform: translate(2px, 2px); }
    80% { transform: translate(2px, -2px); }
}

@keyframes glitch-2 {
    0%, 100% { transform: translate(0); }
    20% { transform: translate(2px, 0); }
    40% { transform: translate(-2px, 0); }
    60% { transform: translate(0, 2px); }
    80% { transform: translate(0, -2px); }
}

/* ============================================
   ANIMATIONS
   ============================================ */

/* Cursor blink */
@keyframes blink {
    0%, 49% { opacity: 1; }
    50%, 100% { opacity: 0; }
}

.blink {
    animation: blink 1s infinite;
}

.cursor::after {
    content: '█';
    animation: blink 1s infinite;
    margin-left: 2px;
}

/* Typing effect */
@keyframes typing {
    from { width: 0; }
    to { width: 100%; }
}

.typing {
    overflow: hidden;
    border-right: 2px solid var(--matrix-green);
    white-space: nowrap;
    animation: typing 3s steps(40) 1s both,
               blink 0.75s step-end infinite;
}

/* Fade in */
@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
}

.fade-in {
    animation: fadeIn 0.6s ease-out;
}

/* Flicker */
@keyframes flicker {
    0%, 100% { opacity: 1; }
    41.99% { opacity: 1; }
    42% { opacity: 0.8; }
    43% { opacity: 1; }
    45.99% { opacity: 1; }
    46% { opacity: 0.6; }
    46.5% { opacity: 1; }
}

.flicker {
    animation: flicker 5s linear infinite;
}

/* ============================================
   MARQUEE / TICKER
   ============================================ */

marquee, .marquee {
    background: var(--bg-darker);
    color: var(--terminal-yellow);
    padding: var(--spacing-sm);
    font-family: var(--font-terminal);
    font-size: 16px;
    border-top: 1px solid var(--matrix-green);
    border-bottom: 1px solid var(--matrix-green);
}

/* ============================================
   COUNTERS & STATS
   ============================================ */

.counter {
    font-family: var(--font-terminal);
    font-size: 24px;
    color: var(--matrix-green);
    font-weight: bold;
    text-shadow: 0 0 10px var(--matrix-green);
}

.stat-box {
    background: var(--bg-darker);
    border: 1px solid var(--matrix-green);
    padding: var(--spacing-md);
    margin: var(--spacing-sm);
    display: inline-block;
}

.stat-label {
    font-size: 12px;
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.stat-value {
    font-size: 28px;
    color: var(--matrix-green);
    font-family: var(--font-terminal);
    font-weight: bold;
}

/* ============================================
   TERMINAL WINDOW STYLE
   ============================================ */

.terminal-window {
    background: var(--bg-darker);
    border: 2px solid var(--matrix-green);
    margin: var(--spacing-md) 0;
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.3);
}

.terminal-header {
    background: var(--matrix-green);
    color: var(--bg-black);
    padding: var(--spacing-sm) var(--spacing-md);
    font-family: var(--font-code);
    font-size: 12px;
    font-weight: bold;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.terminal-buttons {
    display: flex;
    gap: var(--spacing-sm);
}

.terminal-btn {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--bg-black);
}

.terminal-body {
    padding: var(--spacing-md);
    font-family: var(--font-terminal);
    font-size: 16px;
    line-height: 1.4;
    min-height: 200px;
}

/* ============================================
   FORMS & INPUTS
   ============================================ */

input, textarea, select {
    font-family: var(--font-code);
    font-size: 14px;
    padding: var(--spacing-sm);
    background: var(--bg-darker);
    color: var(--matrix-green);
    border: 1px solid var(--matrix-green);
    width: 100%;
    max-width: 400px;
}

input:focus, textarea:focus, select:focus {
    outline: none;
    border-color: var(--terminal-cyan);
    box-shadow: 0 0 5px var(--terminal-cyan);
}

label {
    display: block;
    margin-bottom: var(--spacing-xs);
    color: var(--text-secondary);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* ============================================
   UTILITY CLASSES
   ============================================ */

.mt-1 { margin-top: var(--spacing-sm); }
.mt-2 { margin-top: var(--spacing-md); }
.mt-3 { margin-top: var(--spacing-lg); }

.mb-1 { margin-bottom: var(--spacing-sm); }
.mb-2 { margin-bottom: var(--spacing-md); }
.mb-3 { margin-bottom: var(--spacing-lg); }

.p-1 { padding: var(--spacing-sm); }
.p-2 { padding: var(--spacing-md); }
.p-3 { padding: var(--spacing-lg); }

.text-green { color: var(--matrix-green); }
.text-cyan { color: var(--terminal-cyan); }
.text-red { color: var(--error-red); }
.text-yellow { color: var(--terminal-yellow); }
.text-purple { color: var(--glitch-purple); }

.bg-dark { background: var(--bg-darker); }
.bg-black { background: var(--bg-black); }

.border-green { border: 1px solid var(--matrix-green); }
.border-cyan { border: 1px solid var(--terminal-cyan); }

.glow-green { text-shadow: 0 0 10px var(--matrix-green); }
.glow-cyan { text-shadow: 0 0 10px var(--terminal-cyan); }

/* ============================================
   RESPONSIVE
   ============================================ */

@media (max-width: 768px) {
    html {
        font-size: 14px;
    }
    
    h1 {
        font-size: 2rem;
    }
    
    h2 {
        font-size: 1.5rem;
    }
    
    .container {
        padding: 0 var(--spacing-sm);
    }
}

/* ============================================
   LOADING / PROGRESS INDICATORS
   ============================================ */

.loading-bar {
    width: 100%;
    height: 20px;
    background: var(--bg-darker);
    border: 1px solid var(--matrix-green);
    position: relative;
    overflow: hidden;
}

.loading-bar-fill {
    height: 100%;
    background: var(--matrix-green);
    transition: width 0.3s;
    position: relative;
}

.loading-bar-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.3),
        transparent
    );
    animation: loading-shine 1.5s infinite;
}

@keyframes loading-shine {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(100%); }
}

/* ============================================
   ERROR MESSAGES
   ============================================ */

.error-box {
    background: rgba(255, 51, 102, 0.1);
    border: 2px solid var(--error-red);
    padding: var(--spacing-md);
    margin: var(--spacing-md) 0;
    font-family: var(--font-code);
}

.error-box::before {
    content: '⚠ ERROR: ';
    color: var(--error-red);
    font-weight: bold;
}

.warning-box {
    background: rgba(255, 255, 0, 0.1);
    border: 2px solid var(--terminal-yellow);
    padding: var(--spacing-md);
    margin: var(--spacing-md) 0;
    font-family: var(--font-code);
}

.warning-box::before {
    content: '⚠ WARNING: ';
    color: var(--terminal-yellow);
    font-weight: bold;
}

/* ============================================
   CONSOLE OUTPUT STYLE
   ============================================ */

.console-output {
    background: var(--bg-black);
    border: 1px solid var(--matrix-green-dim);
    padding: var(--spacing-md);
    font-family: var(--font-terminal);
    font-size: 14px;
    line-height: 1.6;
    max-height: 400px;
    overflow-y: auto;
    color: var(--matrix-green);
}

.console-output::-webkit-scrollbar {
    width: 10px;
}

.console-output::-webkit-scrollbar-track {
    background: var(--bg-darker);
}

.console-output::-webkit-scrollbar-thumb {
    background: var(--matrix-green);
}

.console-line {
    margin-bottom: 4px;
}

.console-line::before {
    content: '$ ';
    color: var(--matrix-green-dim);
}
